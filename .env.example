# Copy to .env and fill in. Never commit .env.
# Every value below is optional: Eris starts without a key and runs the
# offline eval / test suite with fake backends.

# --- LLM -------------------------------------------------------------------
# Anthropic API key. Required only for `eris ask` against the real model.
ERIS_ANTHROPIC_API_KEY=
# Claude model id used for answer synthesis.
ERIS_MODEL=claude-sonnet-4-5
# Upper bound on answer length, in tokens.
ERIS_MAX_TOKENS=1024
# Sampling temperature. 0.0 keeps answers deterministic and grounded.
ERIS_TEMPERATURE=0.0

# --- Search ----------------------------------------------------------------
# "duckduckgo" (keyless, needs the `ddgs` extra) or "fake" (offline fixtures).
ERIS_SEARCH_BACKEND=duckduckgo
# Number of search results to request per query.
ERIS_MAX_RESULTS=8

# --- Fetch -----------------------------------------------------------------
# Per-request HTTP timeout, seconds.
ERIS_FETCH_TIMEOUT_S=10.0
# Hard cap on downloaded bytes per page.
ERIS_MAX_PAGE_BYTES=2000000
# Parallel page fetches.
ERIS_FETCH_CONCURRENCY=8
# Sent on every request so operators can identify the crawler.
ERIS_USER_AGENT=eris/0.1 (+https://github.com/arhammxo/eris)

# --- Cache -----------------------------------------------------------------
# Directory holding the sqlite cache.
ERIS_CACHE_DIR=./data/cache
# Time-to-live for cached pages and search results, seconds.
ERIS_CACHE_TTL_S=3600

# --- Retrieval -------------------------------------------------------------
# Number of chunks handed to the model as context.
ERIS_TOP_K=6
# Chunk size and overlap, in characters.
ERIS_CHUNK_SIZE=1200
ERIS_CHUNK_OVERLAP=200
# Hybrid weight: 1.0 = BM25 only, 0.0 = TF-IDF cosine only.
ERIS_BM25_WEIGHT=0.65
# MMR trade-off: 1.0 = pure relevance, 0.0 = pure diversity.
ERIS_MMR_LAMBDA=0.7
# Max chunks kept from any single URL, so one page cannot own the context.
ERIS_MAX_CHUNKS_PER_URL=2

# --- Logging ---------------------------------------------------------------
# CRITICAL | ERROR | WARNING | INFO | DEBUG
ERIS_LOG_LEVEL=WARNING
