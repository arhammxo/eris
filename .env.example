# Eris configuration template.
# Copy to `.env` and fill in values. `.env` is git-ignored; never commit real keys.
# Every variable below is read by config.py. All of them have defaults except
# SECRET_KEY, which run.py requires before it will start.

# --- Secrets / credentials -------------------------------------------------
# Required by run.py. Any random string; used by Quart for session signing.
SECRET_KEY=
# Required for summarization. Without it, generate_summary() raises ModelAPIError.
OPENAI_API_KEY=
# Optional. Without it, search falls back to the DuckDuckGo Instant Answer API
# and then to synthesized example URLs (see modules/search.py).
SERPAPI_API_KEY=

# --- Cache (Flask-Caching) -------------------------------------------------
CACHE_TYPE=
CACHE_DEFAULT_TIMEOUT=

# --- Concurrency -----------------------------------------------------------
MAX_CONCURRENT_REQUESTS=
MAX_CONCURRENT_PER_DOMAIN=

# --- HTTP crawler ----------------------------------------------------------
MAX_URLS_TO_CRAWL=
CRAWL_TIMEOUT=
RESPECT_ROBOTS_TXT=
MAX_RETRIES=
USER_AGENT=

# --- Browser crawler (Playwright) -----------------------------------------
USE_BROWSER_CRAWLER=
BROWSER_INSTANCES=
BROWSER_TIMEOUT=

# --- Content quality scoring ----------------------------------------------
QUALITY_THRESHOLD=
DOMAIN_QUALITY_DB=

# --- Summarization ---------------------------------------------------------
SUMMARY_MODEL=
MAX_TOKENS=

# --- Chunking / Meta-Chunking ---------------------------------------------
CHUNK_SIZE=
USE_META_CHUNKING=
META_CHUNKING_THRESHOLD=
USE_DYNAMIC_COMBINATION=
# When true, perplexity is estimated via the OpenAI API instead of the local
# n-gram model. Costs tokens per sentence.
USE_OPENAI_FOR_PPL=

# --- Source attribution ----------------------------------------------------
ENABLE_ENHANCED_ATTRIBUTION=
ATTRIBUTION_SIMILARITY_THRESHOLD=
ATTRIBUTION_MIN_CONFIDENCE=

# --- Progress tracking (WebSocket UI) -------------------------------------
ENABLE_PROGRESS_TRACKING=

# --- Local file search -----------------------------------------------------
FILE_SEARCH_ENABLED=
# Comma-separated absolute paths. Defaults to ~/Documents when empty.
BASE_DIRECTORIES=
MAX_FILE_SIZE_MB=
SUPPORTED_FILE_EXTENSIONS=
MAX_CONCURRENT_EXTRACTIONS=
